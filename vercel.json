{
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "(?:bot\\.acelera\\.agency|acelera-botmaker-preview\\.vercel\\.app)"
        }
      ],
      "destination": "/botmaker"
    },
    {
      "source": "/api/schedule",
      "destination": "https://acelera-schedule-api.vercel.app/api/schedule"
    }
  ],
  "headers": [
    {
      "source": "/redisenio/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/robots.txt",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, must-revalidate"
        }
      ]
    },
    {
      "source": "/sitemap.xml",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, must-revalidate"
        }
      ]
    },
    {
      "source": "/llms.txt",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, must-revalidate"
        }
      ]
    },
    {
      "source": "/ea91d86f3694501ea4a4cdeec90a106a.txt",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, must-revalidate"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/botmaker",
      "has": [
        {
          "type": "host",
          "value": "(?:bot\\.acelera\\.agency|acelera-botmaker-preview\\.vercel\\.app)"
        }
      ],
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/en/:path*",
      "has": [
        {
          "type": "host",
          "value": "(?:bot\\.acelera\\.agency|acelera-botmaker-preview\\.vercel\\.app)"
        }
      ],
      "destination": "https://www.acelera.agency/en/:path*",
      "permanent": false
    }
  ]
}
